{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-personal-ai",
  "main": "worker.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
